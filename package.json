{
  "name": "modular-server",
  "private": true,
  "version": "1.0.0",
  "description": "Servidor modular mesclando outros servidores nest.js",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:rspack": "nest build --builder rspack",
    "build:full": "sh ./build.sh",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "nest-gen": "nest generate",
    "nest-help": "nest --help",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/index",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0",
    "@nestjs/config": "^12.0",
    "@nestjs/core": "^12.0",
    "@nestjs/jwt": "^12.0",
    "@nestjs/mapped-types": "^2.1",
    "@nestjs/mongoose": "^12.0",
    "@nestjs/passport": "^12.0",
    "@nestjs/platform-fastify": "^12.0",
    "@nestjs/schedule": "^12.0",
    "axios": "^1.20",
    "bcrypt": "^6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.4",
    "passport": "^0.7",
    "passport-jwt": "^4.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0",
    "@nestjs/schematics": "^12.0",
    "@nestjs/testing": "^12.0",
    "@rspack/core": "^2.2.2",
    "@types/bcrypt": "^6.0",
    "@types/jest": "^30.0",
    "@types/node": "^26.3",
    "@types/passport-jwt": "^4.0",
    "@types/supertest": "^7.2",
    "@typescript-eslint/eslint-plugin": "^8.68",
    "@typescript-eslint/parser": "^8.68",
    "eslint": "^10.9",
    "eslint-config-prettier": "^10.1",
    "eslint-plugin-prettier": "^5.5",
    "jest": "^30.4",
    "prettier": "^3.9",
    "source-map-support": "^0.5",
    "supertest": "^7.2",
    "ts-jest": "^29.4",
    "ts-loader": "^9.6",
    "ts-node": "^10.9",
    "tsconfig-paths": "^4.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
